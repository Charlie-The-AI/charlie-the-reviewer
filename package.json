{
  "name": "@thesonofman/charlie-the-reviewer",
  "version": "0.1.0",
  "description": "Charlie the Reviewer: Universal automated AI-powered code reviews for GitHub pull requests and local Git changes, supporting OpenAI and Google Gemini.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "charlie-the-reviewer": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "code-review",
    "github-action",
    "openai",
    "gemini",
    "pull-request",
    "git",
    "reviewer",
    "devsecops"
  ],
  "author": "The Son of Man",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thesonofman/charlie-the-reviewer.git"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "commander": "^14.0.3",
    "micromatch": "^4.0.8",
    "octokit": "^5.0.5",
    "openai": "^7.47.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@eslint/js": "^9.21.0",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
